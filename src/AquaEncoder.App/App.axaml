<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AquaEncoder.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Koyu tema: siyah tonları + amber vurgu -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AqBg" Color="#0E0F11"/>
          <SolidColorBrush x:Key="AqPanel" Color="#16181B"/>
          <SolidColorBrush x:Key="AqCard" Color="#1F2226"/>
          <SolidColorBrush x:Key="AqLine" Color="#2C3036"/>
          <SolidColorBrush x:Key="AqDim" Color="#8B929B"/>
          <SolidColorBrush x:Key="AqAccent" Color="#F5A524"/>
          <SolidColorBrush x:Key="AqAccentHover" Color="#FBBF54"/>
          <SolidColorBrush x:Key="AqAccentFg" Color="#111111"/>
        </ResourceDictionary>
        <!-- Açık tema -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AqBg" Color="#EEF0F3"/>
          <SolidColorBrush x:Key="AqPanel" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AqCard" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="AqLine" Color="#D9DDE2"/>
          <SolidColorBrush x:Key="AqDim" Color="#6B7280"/>
          <SolidColorBrush x:Key="AqAccent" Color="#D97706"/>
          <SolidColorBrush x:Key="AqAccentHover" Color="#B45309"/>
          <SolidColorBrush x:Key="AqAccentFg" Color="#FFFFFF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Paneller -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource AqPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AqLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Metin -->
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource AqDim}"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource AqAccent}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AqDim}"/>
    </Style>

    <!-- Ana buton (Başlat) -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AqAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AqAccentFg}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqAccentHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource AqAccentFg}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqLine}"/>
      <Setter Property="Foreground" Value="{DynamicResource AqDim}"/>
    </Style>

    <!-- Araç çubuğu butonu (düz) -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqCard}"/>
    </Style>

    <!-- Panel içi küçük buton -->
    <Style Selector="Button.small">
      <Setter Property="Background" Value="{DynamicResource AqCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AqLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.small:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqLine}"/>
    </Style>

    <!-- Kuyruk satırları -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Margin" Value="4,1"/>
    </Style>
  </Application.Styles>
</Application>
